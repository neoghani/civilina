# CIVILINA Engineering — production .env TEMPLATE (no secret here).
# Copy to /srv/civilina/app/.env on the server, fill the <…> values there,
# then: chmod 600 .env && php artisan key:generate --force
# Never commit the filled file.

APP_NAME="CIVILINA Engineering"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://app.civilina.com
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=civilina
DB_USERNAME=civilina
DB_PASSWORD=<mot de passe généré sur le serveur>

# Sessions, cache (rate limits) and queue stored in the database.
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

# Outgoing mail (invitations, password reset). Sender: contact@civilina.com
MAIL_MAILER=smtp
MAIL_HOST=<serveur SMTP>
MAIL_PORT=587
MAIL_USERNAME=<identifiant SMTP>
MAIL_PASSWORD=<mot de passe SMTP>
MAIL_SCHEME=null
MAIL_FROM_ADDRESS=contact@civilina.com
MAIL_FROM_NAME="CIVILINA"

# Civilina platform staff (shared normative corpus management), comma separated.
CIVILINA_PLATFORM_STAFF=abdelghani.bouhouche@civilina.com

# Pilot invitations: link validity in minutes (72 h).
CIVILINA_INVITATION_EXPIRE_MINUTES=4320

# Requests per minute and per account.
CIVILINA_RATE_LIMIT_APP=300
CIVILINA_RATE_LIMIT_HEAVY=30
